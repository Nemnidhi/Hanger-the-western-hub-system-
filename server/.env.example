# Every value is checked at start-up (src/config.js); the server refuses to start with a missing or
# malformed one rather than failing later in the middle of an order.

NODE_ENV=development
PORT=4200
LOG_LEVEL=info

# Must be a replica set: an order, its stock, its invoice and its follow-up jobs are saved in one
# transaction. Development: a single-node replica set (see README). Production: Atlas Mumbai or 3 nodes.
MONGODB_URI=mongodb://127.0.0.1:27027/hanger?replicaSet=rs0

TENANT_ID=hanger

# From the brand's own Meta app (App settings > Basic > App secret) and WhatsApp number.
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
# The Meta commerce catalogue shown in WhatsApp and Instagram (Commerce Manager > Catalogue > id).
# Empty: no catalogue sync, and outfit picks go as a text list instead of a product list.
META_CATALOG_ID=
META_GRAPH_VERSION=v24.0

# 32 random bytes as 64 hex characters (encrypts staff two-step login secrets).
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
DATA_ENCRYPTION_KEY=

WORKER_CONCURRENCY=4

# Built staff app. The API serves it when set.
WEB_DIST_DIR=../web/dist

# The brand's website (product links in the Meta catalogue), e.g. https://thehanger.in
PUBLIC_STORE_URL=

# Razorpay payment links on the brand's own account (all three, or none for COD only).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# SMS backup for order updates (needs DLT registration): none | msg91
SMS_PROVIDER=none
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ORDER_UPDATE=
MSG91_TEMPLATE_DELIVERY_CODE=

# Courier booking on the brand's own Shiprocket account: none | shiprocket. Use a separate API user
# (Shiprocket > Settings > API), and the same webhook token in Shiprocket's webhook page.
SHIPPING_PROVIDER=none
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=
SHIPROCKET_WEBHOOK_TOKEN=

# This server's public address (product photos are served from it and Meta fetches them), and where
# the photos are kept.
PUBLIC_BASE_URL=
UPLOAD_DIR=../.data/uploads

# Photo studio: clean product photos (Photoroom, the brand's own API key) and write-ups for the
# website and Instagram (Claude, the brand's own Anthropic key). Either can be left empty.
PHOTOROOM_API_KEY=
ANTHROPIC_API_KEY=
STUDIO_COPY_MODEL=claude-opus-5-5
# Demo only, refused in production: a stand-in returns the photo unchanged and a template write-up.
STUDIO_STAND_IN=false
