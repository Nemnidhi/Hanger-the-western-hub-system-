{
  "name": "hanger-platform",
  "private": true,
  "version": "0.1.0",
  "description": "The Hanger's own commerce platform: catalogue, stock by location, WhatsApp ordering, COD checks, GST invoices, store billing.",
  "workspaces": [
    "server",
    "web",
    "store"
  ],
  "scripts": {
    "test": "npm test --workspace server",
